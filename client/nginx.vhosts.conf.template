upstream hackathon_api { server api:4000; keepalive 16; }

server {
    listen 80 default_server;
    server_name _;
    # Liveness probe for the Docker healthcheck; does not expose any content.
    location = /health {
        default_type text/plain;
        return 200 "ok\n";
    }
    location / { return 444; }
}
server {
    listen 80;
    server_name ${PUBLIC_SERVER_NAME} ${PLANNER_SERVER_NAME} ai.cool-domain.online;
    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 308 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    # QUIC/HTTP3: reuseport is declared once per port (this block); the other
    # TLS servers join the same UDP listener. Requires UDP 443 reachable.
    listen 443 quic reuseport;
    http2 on;
    http3 on;
    add_header Alt-Svc 'h3=":443"; ma=86400' always;
    server_name ${PUBLIC_SERVER_NAME};
    root /usr/share/nginx/html;
    index index.html;
    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/security-headers.conf;

    # The site root points visitors at the SAM registry; the SPA keeps
    # rendering "/" too, so this is a plain redirect, not a rewrite.
    location = / { return 302 /sam; }

    location = /health {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://hackathon_api/health;
    }
    location = /sitemap.xml {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://hackathon_api/sitemap.xml;
    }
    location = /api/chat/stream {
        include /etc/nginx/snippets/proxy-stream.conf;
        proxy_pass http://hackathon_api;
    }
    location ^~ /api/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://hackathon_api;
    }
    location ^~ /auth/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://hackathon_api;
    }
    location ^~ /gitea/ {
        # Gitea owns this subpath. Do not inherit the portal CSP: it blocks
        # Gitea's inline styles and scripts.
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        proxy_pass http://10.77.0.1/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        client_max_body_size 64m;
    }
    location ~* (?:^|/)(?:\.|.*(?:credential|secret|password).*) { return 404; }
    location ~* \.(?:pem|key|p12|pfx|jks|keystore|kdbx|ovpn)$ { return 404; }
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        try_files $uri =404;
    }
    # Static icons and identity files: served unchanged for weeks.
    location ~* ^/(?:dragon|logo)[^/]*\.(?:svg|png)$ {
        expires 30d;
        try_files $uri =404;
    }
    # The SPA route /team collides with the static photos directory:
    # the page goes to the app, /team/*.jpg keep being served as files.
    location = /team { try_files /index.html =404; }
    location = /team/ { try_files /index.html =404; }
    location = /index.html {
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/security-headers.conf;
    }
    location / { try_files $uri $uri/ /index.html; }
}

server {
    listen 443 ssl;
    listen 443 quic;
    http2 on;
    http3 on;
    add_header Alt-Svc 'h3=":443"; ma=86400' always;
    server_name ${PLANNER_SERVER_NAME};
    root /usr/share/nginx/html;
    index index.html;

    # The planner host is a dedicated plan page, not the main landing.
    location = / { return 302 /planner; }
    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/security-headers.conf;

    location = /health {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://hackathon_api/health;
    }
