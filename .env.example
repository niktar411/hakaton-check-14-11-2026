# Публичные адреса задаются только здесь; домен не зашит в код.
PORTAL_LISTEN=0.0.0.0:8080
PUBLIC_BASE_URL=https://cool-domain.online
PLANNER_BASE_URL=https://planner.cool-domain.online
STATIC_DIR=dist
DATABASE_URL=postgres://portal@127.0.0.1:5432/portal?sslmode=disable
TEST_DATABASE_URL=postgres://portal@127.0.0.1:5432/portal_test?sslmode=disable

# GitLab OAuth для прежнего командного чата и отдельный технический токен API.
# Текущий сервер: GitLab слушает порт 80 -> http://10.77.0.1
# Полный Compose-стек: GitLab на 8081 -> http://10.77.0.1:8081
GITLAB_URL=http://10.77.0.1
GIT_PROVIDER=gitea
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_TOKEN=
GITLAB_PROJECT=hackathon/hackathon
GITLAB_WEBHOOK_SECRET=

# Ограниченные агенты основного и рабочего серверов.
AGENT_URL=http://10.77.0.1:9101
AGENT_TOKEN=
WORKER_URL=http://10.77.0.10:9102
WORKER_TOKEN=

# DeepSeek через Cloud.ru. Ключ можно задать здесь или зашифрованно обновить в админке.
MODEL_URL=https://foundation-models.api.cloud.ru/v1
MODEL_NAME=DeepSeek-V3
MODEL_API_KEY=
# 32 случайных байта в base64 без завершающего '='; не использовать пример как ключ.
SETTINGS_ENCRYPTION_KEY=

ADMIN_USERNAME=niktar411
ADMIN_VPN_IP=10.77.0.2
MIHOMO_CONFIG_PATH=infra/mihomo/hackathon.yaml
